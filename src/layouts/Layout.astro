---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Nikos Panagiotopoulos' } = Astro.props;
---

<!doctype html>
<html lang="el">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
</head>

<body id="work">
<slot />
</body>
</html>
