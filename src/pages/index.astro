---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { getEditorials, inCategory } from '../lib/editorials';

const editorials = getEditorials();
const magazineSections = [
  { label: 'Covers', items: inCategory(editorials, 'covers') },
  { label: 'Editorials', items: inCategory(editorials, 'editorials') },
];
const instagram = 'https://www.instagram.com/nickospanagiotopoulos';
const email = 'nickofow@gmail.com';

// Πολλά έτοιμα μεγέθη ανά φωτογραφία, ώστε κάθε οθόνη να παίρνει ένα αρχείο σχεδόν ίσο με
// το μέγεθος που δείχνει. Αλλιώς ο browser μικραίνει πολύ τη φωτογραφία στον υπολογιστή
// και τη «σκληραίνει».
const photoWidths = [180, 270, 360, 420, 520, 640, 760, 844, 960, 1040, 1280];
const photoQuality = 90;
---

<Layout>
<input type="checkbox" id="menu-toggle">
<label class="hamburger" for="menu-toggle" aria-label="Open menu">
  <span></span>
  <span></span>
  <span></span>
</label>

<aside class="menu-panel">
  <nav>
    <a href="#work">Work</a>
    <a href="#magazines-page">Magazines</a>
    <a href="#contact-page">Contact</a>
    <a href={instagram} target="_blank">Instagram</a>
  </nav>
  <div class="menu-small">Nikos Panagiotopoulos<br>Photographer</div>
</aside>

<header class="header">
  <a href="#work">
    <div class="name">NIKOS PANAGIOTOPOULOS</div>
  </a>
</header>

<main>
  <div class="covers">
    {editorials.map((e) => (
      <a class="preview" href={`#editorial-${e.slug}`} aria-label={`Open ${e.title} editorial`}>
        <Image
          src={e.cover}
          widths={photoWidths}
          quality={photoQuality}
          sizes="(max-width: 760px) min(calc(100vw - 36px), 420px), 520px"
          loading="eager"
          alt={`${e.title} preview`}
        />
      </a>
    ))}
  </div>

</main>

<footer>
  <span>© 2026 NIKOS PANAGIOTOPOULOS</span>
  <a href="#work">Back to top</a>
</footer>

<div class="page" id="magazines-page">
  <div class="page-top">
    <div>
      <div class="page-title">Magazines</div>
      <div class="page-sub">Selected publications and features</div>
    </div>
    <a class="close-page" href="#work">Close</a>
  </div>

  <div class="page-body">
    {magazineSections.map((section) => (
      <div class="page-grid">
        <div class="page-label magazine-label">{section.label}</div>
        <div class="page-content">
          {section.items.length ? (
            <ul class="magazine-list">
              {section.items.map((e) => (
                <li>
                  <a class="magazine-title" href={`#editorial-${e.slug}`}>{e.title}</a>
                  {e.description && <div class="magazine-sub">{e.description}</div>}
                </li>
              ))}
            </ul>
          ) : (
            <p class="magazine-empty">Coming soon.</p>
          )}
        </div>
      </div>
    ))}
  </div>
</div>

<div class="page" id="contact-page">
  <div class="page-top">
    <div>
      <div class="page-title">Contact</div>
      <div class="page-sub">Bookings and collaborations</div>
    </div>
    <a class="close-page" href="#work">Close</a>
  </div>

  <div class="page-body">
    <div class="page-grid">
      <div class="page-label">Form</div>
      <div class="page-content">
        <form class="contact-form" action="/api/contact" method="post">
          <div class="form-row">
            <label for="first-name">Name</label>
            <input id="first-name" name="Name" type="text" autocomplete="given-name" required>
          </div>

          <div class="form-row">
            <label for="last-name">Surname</label>
            <input id="last-name" name="Surname" type="text" autocomplete="family-name" required>
          </div>

          <div class="form-row">
            <label for="email">Email</label>
            <input id="email" name="Email" type="email" autocomplete="email" required>
          </div>

          <div class="form-row">
            <label for="message">Reason / Message</label>
            <textarea id="message" name="Message" required></textarea>
          </div>

          <div class="form-row form-trap" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off">
          </div>

          <button class="submit-button" type="submit">Send</button>
        </form>

        <p class="form-status" role="status" aria-live="polite"></p>
      </div>
    </div>

    <div class="page-grid">
      <div class="page-label">Direct</div>
      <div class="page-content">
        <a href={`mailto:${email}`}>{email}</a><br>
        <a href={instagram} target="_blank">@nickospanagiotopoulos</a>
      </div>
    </div>
  </div>
</div>

{editorials.map((e) => (
  <div class="editorial" id={`editorial-${e.slug}`}>
    <div class="editorial-top">
      <div>
        <div class="editorial-title">{e.title}</div>
        {e.magazine ? (
          <div class="editorial-magazine">{e.magazine}</div>
        ) : (
          <div class="editorial-sub">{e.description ?? 'Editorial gallery'}</div>
        )}
      </div>
      <a class="close-editorial" href="#work">Close</a>
    </div>

    <div class="editorial-body">
      {e.models && <p class="editorial-models">{e.models}</p>}
      {e.note && <p class="editorial-note">{e.note}</p>}
      {e.text && (
        <div class="editorial-text">
          {e.text.split(/\n\s*\n/).map((paragraph) => (
            <p>{paragraph.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>
          ))}
        </div>
      )}
      <div class="gallery">
        {e.photos.map((photo, i) => (
          <Image
            src={photo}
            widths={photoWidths}
            quality={photoQuality}
            sizes="(max-width: 760px) calc((100vw - 44px) / 2), min(calc((100vw - 96px) / 3), 268px)"
            alt={`${e.title} editorial image ${i + 1}`}
          />
        ))}
      </div>
    </div>
  </div>
))}

<div class="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer" aria-hidden="true">
  <button class="lightbox-close" type="button" aria-label="Close">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20" /></svg>
  </button>
  <button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous image">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3l-9 9 9 9" /></svg>
  </button>
  <img class="lightbox-img" alt="">
  <button class="lightbox-nav lightbox-next" type="button" aria-label="Next image">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3l9 9-9 9" /></svg>
  </button>
</div>

<script is:inline define:vars={{ email }}>
document.querySelectorAll('.menu-panel a').forEach(function(link) {
  link.addEventListener('click', function() {
    document.getElementById('menu-toggle').checked = false;
  });
});

// Φόρμα επικοινωνίας: στέλνει το μήνυμα χωρίς να φύγει ο επισκέπτης από τη σελίδα.
(function() {
  var form = document.querySelector('.contact-form');
  var status = document.querySelector('.form-status');
  var button = form.querySelector('button');
  var sentText = 'Thank you, your message has been sent.';
  var errorText = 'Something went wrong. Please email ' + email + ' directly.';

  // Χωρίς JavaScript η φόρμα επιστρέφει εδώ με ?sent=1 ή ?error=1.
  var params = new URLSearchParams(location.search);
  if (params.has('sent')) status.textContent = sentText;
  if (params.has('error')) status.textContent = errorText;

  form.addEventListener('submit', function(event) {
    event.preventDefault();
    button.disabled = true;
    status.textContent = 'Sending…';

    fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
      .then(function(response) { return response.json(); })
      .then(function(result) {
        if (!result.ok) throw new Error('not sent');
        form.reset();
        status.textContent = sentText;
      })
      .catch(function() { status.textContent = errorText; })
      .finally(function() { button.disabled = false; });
  });
})();

// Lightbox: πατώντας μια φωτογραφία μέσα σε editorial, ανοίγει μόνη της σε άσπρο φόντο,
// με βελάκια για την προηγούμενη / επόμενη φωτογραφία του ίδιου editorial.
(function() {
  var box = document.querySelector('.lightbox');
  var view = box.querySelector('.lightbox-img');
  var closeButton = box.querySelector('.lightbox-close');
  var prevButton = box.querySelector('.lightbox-prev');
  var nextButton = box.querySelector('.lightbox-next');
  var photos = [];
  var current = 0;
  var opener = null;

  function show(index) {
    current = (index + photos.length) % photos.length;
    var photo = photos[current];
    view.classList.remove('is-shown');
    view.src = bestFile(photo);
    view.alt = photo.alt;
    // Νέο frame, ώστε να ξαναπαίξει το απαλό ζουμ σε κάθε φωτογραφία.
    requestAnimationFrame(function() { view.classList.add('is-shown'); });
  }

  // Το μικρότερο έτοιμο αρχείο που καλύπτει το μέγεθος της φωτογραφίας στην προβολή (ίδια
  // όρια με το CSS της .lightbox-img). Το διαλέγουμε εμείς, γιατί ο browser θα ξανάπαιρνε
  // το μεγαλύτερο αρχείο της λίστας και θα το μίκραινε πολύ.
  function bestFile(photo) {
    var mobile = window.matchMedia('(max-width: 760px)').matches;
    var maxWidth = mobile ? window.innerWidth : window.innerWidth - 160;
    var maxHeight = window.innerHeight - (mobile ? 140 : 80);
    var needed = Math.min(maxWidth, maxHeight * photo.width / photo.height) * window.devicePixelRatio;
    var files = photo.srcset.split(',').map(function(entry) {
      var parts = entry.trim().split(/\s+/);
      return { url: parts[0], width: parseInt(parts[1], 10) };
    }).sort(function(a, b) { return a.width - b.width; });
    var match = files.filter(function(file) { return file.width >= needed; })[0];
    return (match || files[files.length - 1]).url;
  }

  function open(photo) {
    photos = Array.prototype.slice.call(photo.closest('.editorial-body').querySelectorAll('img'));
    opener = photo;
    box.classList.toggle('is-single', photos.length < 2);
    show(photos.indexOf(photo));
    box.classList.add('is-open');
    box.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';
    closeButton.focus();
  }

  function close() {
    box.classList.remove('is-open');
    box.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
    if (opener) opener.focus({ preventScroll: true });
  }

  document.querySelectorAll('.editorial-body img').forEach(function(photo) {
    photo.tabIndex = 0;
    photo.addEventListener('click', function() { open(photo); });
    photo.addEventListener('keydown', function(event) {
      if (event.key === 'Enter') open(photo);
    });
  });

  closeButton.addEventListener('click', close);
  prevButton.addEventListener('click', function() { show(current - 1); });
  nextButton.addEventListener('click', function() { show(current + 1); });

  // Κλικ στο φόντο (όχι στη φωτογραφία ή στα κουμπιά) κλείνει.
  box.addEventListener('click', function(event) {
    if (event.target === box) close();
  });

  document.addEventListener('keydown', function(event) {
    if (!box.classList.contains('is-open')) return;
    if (event.key === 'Escape') close();
    if (event.key === 'ArrowLeft') show(current - 1);
    if (event.key === 'ArrowRight') show(current + 1);
  });

  // Στο κινητό: σύρσιμο αριστερά / δεξιά για αλλαγή φωτογραφίας.
  var touchX = null;
  box.addEventListener('touchstart', function(event) {
    touchX = event.touches[0].clientX;
  }, { passive: true });
  box.addEventListener('touchend', function(event) {
    if (touchX === null || photos.length < 2) return;
    var dx = event.changedTouches[0].clientX - touchX;
    touchX = null;
    if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1));
  });
})();
</script>
</Layout>

<style>
  .covers {
    display: grid;
    gap: 28px;
    width: min(100%, 520px);
    margin: 0 auto;
  }

  .covers .preview {
    width: 100%;
  }

  .covers .preview img {
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center 25%;
    transition: filter .35s ease;
  }

  /* Απαλό σκούρεμα του εξωφύλλου στο hover (υπολογιστής) και στο πάτημα (κινητό).
     Το hover μόνο σε συσκευές με ποντίκι, αλλιώς στο κινητό «κολλάει» μετά το πάτημα. */
  .covers .preview:focus-visible img,
  .covers .preview:active img {
    filter: brightness(.7);
  }

  @media (hover: hover) {
    .covers .preview:hover img {
      filter: brightness(.7);
    }
  }

  .magazine-label {
    font-family: Georgia, "Times New Roman", Times, serif;
    font-size: 20px;
    font-weight: 700;
  }

  .magazine-list li {
    margin-bottom: 22px;
  }

  .magazine-title {
    font-family: Georgia, "Times New Roman", Times, serif;
    font-size: 22px;
    letter-spacing: .04em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--text);
    transition: opacity .2s ease;
  }

  .magazine-title {
    display: inline-block;
  }

  .magazine-title:active {
    opacity: .6;
  }

  @media (hover: hover) {
    .magazine-title:hover {
      opacity: .6;
    }
  }

  .magazine-sub {
    margin-top: 4px;
    font-size: 12px;
  }

  .magazine-empty {
    margin: 0;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    opacity: 0;
    visibility: hidden;
    transition: opacity .25s ease, visibility .25s ease;
  }

  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-img {
    max-width: calc(100vw - 160px);
    max-height: calc(100dvh - 80px);
    width: auto;
    height: auto;
    object-fit: contain;
    opacity: 0;
    transform: scale(.96);
    transition: opacity .3s ease, transform .4s ease;
  }

  .lightbox-img.is-shown {
    opacity: 1;
    transform: scale(1);
  }

  .lightbox button {
    position: absolute;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    opacity: .7;
    transition: opacity .2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .lightbox button:focus-visible {
    opacity: 1;
    outline: 1px solid var(--line);
    outline-offset: 2px;
  }

  @media (hover: hover) {
    .lightbox button:hover {
      opacity: 1;
    }
  }

  .lightbox svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .lightbox-close {
    top: 18px;
    right: 18px;
    width: 44px;
    height: 44px;
  }

  .lightbox-close svg {
    width: 26px;
    height: 26px;
  }

  .lightbox-nav {
    top: 50%;
    width: 64px;
    height: 96px;
    transform: translateY(-50%);
  }

  .lightbox-nav svg {
    width: 28px;
    height: 56px;
  }

  .lightbox-prev {
    left: 12px;
  }

  .lightbox-next {
    right: 12px;
  }

  .lightbox.is-single .lightbox-nav {
    display: none;
  }

  .form-trap {
    position: absolute;
    left: -9999px;
  }

  .form-status {
    min-height: 1.5em;
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 12px;
  }

  /* Οι φωτογραφίες ενός editorial ως πλέγμα: 3 στη σειρά σε υπολογιστή, 2 στο κινητό.
     Κόβονται όλες σε 2:3 για ομοιόμορφο πλέγμα. Ολόκληρες φαίνονται στην προβολή. */
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .gallery img {
    margin: 0;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    object-position: center 25%;
    transition: filter .35s ease;
  }

  .gallery img:active {
    filter: brightness(.7);
  }

  @media (hover: hover) {
    .gallery img:hover {
      filter: brightness(.7);
    }
  }

  /* Ελάχιστα πιο έντονος τίτλος: η Georgia δεν έχει ενδιάμεσο βάρος, οπότε παχαίνουμε λίγο το περίγραμμα. */
  .editorial-title {
    -webkit-text-stroke: .45px currentColor;
  }

  .editorial-magazine {
    margin-top: 6px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: .02em;
  }

  .editorial-models {
    max-width: 560px;
    margin: 0 0 14px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--text);
  }

  .editorial-note {
    max-width: 560px;
    margin: 0 0 18px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .02em;
    line-height: 1.5;
    color: var(--text);
  }

  .editorial-text {
    max-width: 560px;
    margin: 0 0 36px;
  }

  .editorial-text p {
    margin: 0 0 1em;
    color: #333;
    font-size: 15px;
    line-height: 1.65;
  }

  @media (max-width: 760px) {
    footer {
      display: flex;
    }

    footer a {
      margin-top: 0;
      white-space: nowrap;
    }

    .lightbox-img {
      max-width: 100vw;
      max-height: calc(100dvh - 140px);
    }

    .lightbox-close {
      top: 10px;
      right: 8px;
    }

    .lightbox-nav {
      top: auto;
      bottom: 12px;
      transform: none;
      width: 56px;
      height: 56px;
    }

    .lightbox-nav svg {
      width: 18px;
      height: 36px;
    }

    .lightbox-prev {
      left: calc(50% - 72px);
    }

    .lightbox-next {
      right: calc(50% - 72px);
    }

    .editorial-title {
      -webkit-text-stroke-width: .25px;
    }

    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    .covers {
      gap: 18px;
      width: min(100%, 420px);
    }
  }
</style>
